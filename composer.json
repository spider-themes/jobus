{
  "name": "arifrahmanbb/jobus",
  "description": "Jobus is a WordPress Plugin for project dependency management.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "arifrahmanbb",
      "email": "arifbb79@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "jobus\\": [
        ".",
        "Admin/",
        "includes/Classes/",
        "includes/Elementor/",
        "includes/Frontend/"
      ]
    },
    "files": [
      "includes/functions.php",
      "includes/filters.php"
    ]
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "freemius/wordpress-sdk",
        "version": "2.13.5",
        "dist": {
          "type": "zip",
          "url": "packages/wordpress-sdk-2.13.5.zip"
        },
        "require": {
          "php": ">=5.6"
        },
        "autoload": {
          "files": [
            "start.php"
          ]
        }
      }
    }
  ],
  "require": {
    "freemius/wordpress-sdk": "^2.13"
  }
}
