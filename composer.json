{
  "name": "arifrahmanbb/jobus",
  "description": "Jobus is a WordPress Plugin for project dependency management.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "arifrahmanbb",
      "email": "arifbb79@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "jobus\\": [
        ".",
        "Admin/",
        "includes/Classes/",
        "includes/Elementor/",
        "includes/Frontend/"
      ]
    },
    "files": [
      "includes/functions.php",
      "includes/filters.php"
    ]
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "freemius/wordpress-sdk",
        "version": "2.13.5",
        "dist": {
          "type": "zip",
          "url": "packages/wordpress-sdk-2.13.5.zip"
        },
        "require": {
          "php": ">=5.6"
        },
        "autoload": {
          "files": [
            "start.php"
          ]
        }
      }
    }
  ],
  "require": {
    "freemius/wordpress-sdk": "^2.13"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.1",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "scripts": {
    "syntax": "find . -name '*.php' -not -path './vendor/*' -not -path './lib/*' -not -path './node_modules/*' -not -path './build/*' -not -path './assets/vendors/*' -exec php -l {} +",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyze": "phpstan analyse"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
